# Taskly mobile API base URL used by the Expo app.
# Choose the URL that is reachable from the runtime device.
#
# Web browser / iOS simulator on the same machine:
EXPO_PUBLIC_TASKLY_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Android emulator usually needs the host-machine alias instead of localhost:
# EXPO_PUBLIC_TASKLY_API_BASE_URL=http://10.0.2.2:3000
#
# Expo Go on a physical phone must use your computer LAN IP, for example:
# EXPO_PUBLIC_TASKLY_API_BASE_URL=http://192.168.1.25:3000
# Start the backend so it listens on the LAN, and keep the phone/computer on the same Wi-Fi.
#
# Do not commit real secrets.
# Only EXPO_PUBLIC_* variables are exposed to the mobile app, and they are not secret.
